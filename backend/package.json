{
  "name": "esurat-backend",
  "version": "1.0.0",
  "description": "E-Surat Backend API with Express.js",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "vercel-build": "tsc",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate-folders": "tsx src/scripts/migrateFolders.ts",
    "check-google-config": "tsx src/scripts/checkGoogleConfig.ts",
    "fix-google-key": "tsx src/scripts/fixGoogleKey.ts",
    "test-google-connection": "tsx src/scripts/testGoogleConnection.ts",
    "test-google-append": "tsx src/scripts/testGoogleAppend.ts",
    "test-private-key": "tsx src/scripts/testPrivateKey.ts",
    "debug-private-key": "tsx src/scripts/debugPrivateKey.ts",
    "get-oauth-token": "tsx src/scripts/getOAuthToken.ts",
    "check-permissions": "tsx src/scripts/checkServiceAccountPermissions.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "google-auth-library": "^9.14.2",
    "googleapis": "^144.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.21.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
